# Copy to backend/.env and fill in values. Never commit .env.

# Required for real AI (get a key at https://console.groq.com)
GROQ_API_KEY=

# Optional overrides
# Quality tasks (generate backlog, sprint, standup)
GROQ_MODEL=llama-3.3-70b-versatile
# Cheap model for import enrich only (selected folders)
GROQ_IMPORT_MODEL=llama-3.1-8b-instant
# auto (use Groq when key set) | groq (require key) | stub (offline only)
SPRINTLINE_AI_MODE=auto

# Token budgets (frugal free-tier defaults — raise for more context/quality)
# Backlog packs repo files into the prompt (largest cost lever)
# SPRINTLINE_BACKLOG_MAX_FILES=12
# SPRINTLINE_BACKLOG_MAX_CHARS=10000
# SPRINTLINE_BACKLOG_MAX_TOKENS=2500
# SPRINTLINE_SPRINT_MAX_TOKENS=1200
# SPRINTLINE_STANDUP_MAX_TOKENS=900
# SPRINTLINE_IMPORT_MAX_TOKENS=1400
# SPRINTLINE_IMPORT_MAX_CHARS=4000
# Log Groq prompt/completion tokens (server log + /api/health ai.usage)
# SPRINTLINE_LOG_LLM_USAGE=true

# Optional: folder scanned by "Import from folder"
# PROJECTS_ROOT=/home/you/Projects
